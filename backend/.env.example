# Server Port (optional, defaults to 8080 or platform injected $PORT)
PORT=8080

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/dataflowx
DATABASE_USERNAME=dataflowx
DATABASE_PASSWORD=change-me

# Docker Compose DB Service Variables
POSTGRES_USER=dataflowx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dataflowx

# JWT Configuration (MUST be set to a custom secret of at least 32 characters; the example placeholder below is rejected by the production profile)
JWT_SECRET=change-me-to-a-secure-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# CORS Configuration (comma-separated exact origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173
